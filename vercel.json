{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/terminos", "destination": "/terminos.html" },
    { "source": "/privacidad", "destination": "/privacidad.html" },
    { "source": "/((?!assets/|img/|.*\\.).*)", "destination": "/index.html" }
  ]
}
